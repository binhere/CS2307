# Values have no trailing comments: docker run --env-file and kubectl --from-env-file
# would keep them as part of the value.
# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=real_estate

HOST_DB=postgres
PORT_DB=5432
USERNAME_DB=postgres
PASSWORD_DB=changeme
DATABASE=real_estate
# Optional full URL used by Alembic instead of the five variables above.
# DATABASE_URL=postgresql+psycopg2://postgres:changeme@postgres:5432/real_estate

# MinIO (optional: leave MINIO_END_POINT empty when there are no images; the
# frontend then shows its illustration for every listing)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_END_POINT=minio:9000
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=changeme
MINIO_BUCKET_NAME=real-estate-images
MINIO_SECURE=False

# Neo4j
NEO4J_AUTH=neo4j/changeme
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
# Server-side limit for one graph query; a slow graph falls back to PostgreSQL.
# NEO4J_QUERY_TIMEOUT_SECONDS=10

# App
DEBUG=True
VERSION=1.0.0
PROJECT_NAME=real-estate-recommendation-system
# Also write logs to this rotated file (stderr always gets them). Leave unset in containers.
# LOG_FILE_PATH=./logs/app.log

# LLM: bring your own key. Each user enters their own provider and API key on the
# "Cài đặt AI" page; the browser sends it with every AI request (X-LLM-* headers) and
# the backend uses it for that request only — it is never stored or logged.
# Leave the server keys below empty in a public deployment: requests without a user
# key are then refused instead of spending the server's quota. Fill them only for
# local development or a private deployment.
# gemini | openai | openai-compatible | groq | grok
BACKEND_LLM_PROVIDER=gemini
BACKEND_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEYS=
# BACKEND_LLM_BASE_URL=           # required for custom openai-compatible endpoints
# BACKEND_LLM_API_KEY=            # may be empty for local Ollama/vLLM endpoints
# Let users point requests at any OpenAI-compatible URL (provider "custom"). Keep false
# on a public server: a user-chosen URL lets anyone make the server call internal hosts.
ALLOW_CUSTOM_LLM_BASE_URL=false

# Hybrid search (PostgreSQL FTS + pgvector + optional Neo4j graph retrieval)
# Embeddings run on the server with one fixed model (users' keys are never used here:
# query vectors must come from the model that embedded the catalog). The default
# "embedding" service in docker-compose runs Ollama on CPU with qwen3-embedding:0.6b.
# Changing the model or the prefixes requires re-embedding the whole catalog
# (scripts/build_search_index.py --skip-catalog-import --skip-graph-metadata --force).
SEARCH_EMBEDDING_MODEL=qwen3-embedding:0.6b
SEARCH_EMBEDDING_BASE_URL=http://embedding:11434/v1
# SEARCH_EMBEDDING_API_KEY=
# Text prepended to queries / catalog passages before embedding (empty for Qwen3).
# SEARCH_EMBEDDING_QUERY_PREFIX=
# SEARCH_EMBEDDING_PASSAGE_PREFIX=
# HTTP timeout for passage batches (index backfill). A search query's embedding
# request is additionally capped at SEARCH_EMBEDDING_STAGE_TIMEOUT_SECONDS.
# SEARCH_EMBEDDING_TIMEOUT=60
# Optional for providers/models with configurable output size. The PostgreSQL
# search schema currently requires vector(1024).
# SEARCH_EMBEDDING_REQUEST_DIMENSIONS=1024
SEARCH_USE_LLM_PARSER=false

# Natural-language answer + per-listing explanation/comparison. Falls back to the
# deterministic explanation automatically when no LLM API key is configured.
SEARCH_USE_LLM_ANSWER=true

SEARCH_USE_NEO4J=true
# LangGraph chat agents. The configured OpenAI-compatible endpoint must support
# native Chat Completions tool_calls for the consultant branch.
CHAT_MODEL_TIMEOUT_SECONDS=60
CHAT_TOOL_TIMEOUT_SECONDS=90
# Per-stage budgets inside one search; a slow stage falls back instead of failing the turn.
# Keep their sum below CHAT_TOOL_TIMEOUT_SECONDS.
# SEARCH_PARSER_TIMEOUT_SECONDS=20
# SEARCH_EMBEDDING_STAGE_TIMEOUT_SECONDS=20
# SEARCH_ANSWER_TIMEOUT_SECONDS=25
# Per-call timeout and retry count for query parsing / answer generation.
# LLM_REQUEST_TIMEOUT_SECONDS=45
# LLM_MAX_RETRIES=2
# SQLAlchemy pool; Postgres max_connections is 100 by default.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# Per-statement limit on every pooled connection (0 disables it).
# DB_STATEMENT_TIMEOUT_SECONDS=15
BACKEND_URL=http://127.0.0.1:8001

# Auth (simple username/password, single access token — no refresh)
ACCESS_TOKEN_SECRET_KEY=changeme
ALGORITHM=HS256
# 7 days; long enough that there is nothing to refresh
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Coordinates of posted listings that came without them (most zip uploads): a job in the backend
# looks their street up every GEOCODING_INTERVAL_SECONDS (0 turns it off). Defaults to the public
# Nominatim server, which allows one request per second and requires a User-Agent that identifies
# this deployment. Point GEOCODER_URL at a self-hosted Nominatim to lift the limit.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=real-estate-listing-geocoder/1.0
# GEOCODING_INTERVAL_SECONDS=300

# Shared demo account offered on the sign-in page (public credentials, no extra rights). The backend
# creates it and restores this password whenever it is used. Set DEMO_ACCOUNT_USERNAME empty to turn
# it off; frontend/lib/demo-account.ts shows the defaults on the sign-in page.
# DEMO_ACCOUNT_USERNAME=admin@gmail.com
# DEMO_ACCOUNT_PASSWORD=demo123456
